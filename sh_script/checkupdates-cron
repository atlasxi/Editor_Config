log_cache="$HOME/.cache/checkupdates-cron.log"
err_cache="$HOME/.cache/checkupdates-cron.err"

update_time=$(stat -c "%Y" "$log_cache")

current_time=$(date +%s)
update_frequency=43200

update_cache(){

checkupdates --nocolor | awk '{print $1}' | tr '\n' ' ' > "$log_cache"
checkupdates --nocolor 2> "$err_cache"
}

if [[ ! -f "$log_cache" ]]; then
	update_cache
fi

if [[ $(("$current_time" - "$update_time")) -gt "$update_frequency" ]]; then
	update_cache
else
	echo "Already update within past $(($update_frequency/3600)) hours"
	exit 1
fi
